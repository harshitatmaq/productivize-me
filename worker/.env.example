# Worker-only settings. The worker ALSO reads the app's .env.local (Supabase URL +
# SUPABASE_SECRET_KEY, AI keys, search keys) — keep both files next to each other.

# How this worker shows up in the app (Jobs → Activity)
WORKER_NAME=oracle-vm

# Which sites to scrape with JobSpy (public listings, no login).
# Oracle VM (cloud IP):   indeed,naukri,glassdoor
# Your Windows PC (home IP, best for LinkedIn): linkedin,indeed,naukri
JOBSPY_SITES=indeed,naukri,glassdoor

# Python used for JobSpy. Docker sets this automatically; on Windows usually "py".
# JOBSPY_PYTHON=py

# Gmail job alerts: "email:app password" pairs, comma-separated, for each person
# whose "Productivize" label this worker should read. Use the same Gmail app
# password you made for email digests. Only that label is opened.
# GMAIL_ACCOUNTS=you@gmail.com:abcd efgh ijkl mnop,friend@gmail.com:wxyz abcd efgh ijkl
# GMAIL_LABEL=Productivize

# How often the worker checks which sources are due (minutes). Sources still
# respect their own intervals (JobSpy ~hourly, curated companies every 2h, …).
WORKER_TICK_MINUTES=5
