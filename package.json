{
  "name": "productivize-me",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "vapid": "web-push generate-vapid-keys",
    "create-user": "node --env-file=.env.local scripts/create-user.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=worker/.env --import tsx worker/index.ts",
    "worker:once": "node --conditions=react-server --env-file-if-exists=.env.local --env-file-if-exists=worker/.env --import tsx worker/index.ts --once"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tanstack/react-query": "^5.105.3",
    "chrono-node": "^2.10.3",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "imapflow": "^2.10.0",
    "lucide-react": "^1.66.0",
    "mailparser": "^3.14.1",
    "motion": "^14.9.1",
    "next": "16.4.4",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "ts-fsrs": "^6.0.0",
    "unpdf": "^2.1.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-pgvector": "^0.0.15",
    "@tailwindcss/turbopack": "^4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.9"
  }
}
