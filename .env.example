# =============================================================================
# Productivize — environment variables
# Copy to .env.local for local dev; add the same keys in Vercel → Settings →
# Environment Variables for production. Only NEXT_PUBLIC_* values reach the
# browser; everything else stays on the server.
# =============================================================================

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The founding accounts (comma separated). Anyone you invite to a shared
# dashboard (Together → Invite) also gets access — the app stays invite-only.
ALLOWED_EMAILS=you@example.com,friend@example.com
# Any long random string. The scheduler (Supabase pg_cron) sends it as a Bearer token.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (older projects call it the anon key — either works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (older projects: service_role). Server only — used by background jobs.
SUPABASE_SECRET_KEY=

# --- Web push (generate once: npm run vapid) ---------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email digests (any SMTP; Gmail needs an App Password) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Productivize <you@gmail.com>"

# --- LLMs: free tiers, tried in this order (best → slowest-but-reliable) -------
# Anything without a key is skipped. Each *_MODELS takes a comma-separated list;
# rate limits are per model, so the chain tries every model before moving on.
# Model line-ups change often — run `npm run ai:check` to see which models your
# keys can use; it prints the exact lines to paste here.
LLM_PROVIDER_ORDER=groq,gemini,cloudflare,nvidia,openrouter,mistral,cerebras,maq

GROQ_API_KEY=
# GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Groq's free tier allows ~8K tokens/minute per model; bigger requests skip Groq (0 = no limit).
# GROQ_MAX_REQUEST_TOKENS=7500

GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-3.8-flash,gemini-2.5-flash-lite
# Note: Google may use free-tier prompts to improve its products. To keep personal
# data (resume, tasks, habits, beliefs, shared chat) away from it, set:
# LLM_NO_PERSONAL_DATA=gemini

# Cloudflare Workers AI (free daily allowance): an API token + your account id.
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_MODELS=@cf/google/gemma-4-26b-a4b-it

# NVIDIA build.nvidia.com (free trial credits; use as a fallback).
NVIDIA_API_KEY=
# NVIDIA_MODELS=nvidia/nemotron-3-ultra-550b-a55b

OPENROUTER_API_KEY=
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-26b-a4b-it:free,openai/gpt-oss-120b:free

MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-small-latest

# Cerebras now needs a payment method; it's only used if you add a key.
CEREBRAS_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b

# MAQ AI — OpenAI-compatible endpoint, kept last because it's slow but always available.
MAQ_AI_BASE_URL=https://your-maq-endpoint.example.com/v1
MAQ_AI_API_KEY=
MAQ_AI_MODELS=
# MAQ_AI_TIMEOUT_MS=180000
# MAQ_AI_JSON_MODE=false

# Lanes: each kind of task has its own model order built in (quick replies, Plan my
# day, job scoring, writing, the board assistant). They only use providers in
# LLM_PROVIDER_ORDER and models in the *_MODELS lists. Override a lane or a task:
# LLM_LANE_SCORING=groq:openai/gpt-oss-120b,cloudflare,openrouter,gemini:gemini-2.5-flash-lite,maq
# LLM_PURPOSE_LANES=job-analysis:writing,plan-day:plan
# LLM_PURPOSE_FIRST=job-query:groq:openai/gpt-oss-20b
# LLM_LANES=off   # one chain for everything (the old behaviour)

# --- Web search for jobs (fallback order; budgets are spread evenly over the month)
SEARCH_PROVIDER_ORDER=tavily,serper,brave,exa,searxng
TAVILY_API_KEY=
# TAVILY_MONTHLY_LIMIT=900
SERPER_API_KEY=
# SERPER_MONTHLY_LIMIT=200
BRAVE_API_KEY=
# BRAVE_MONTHLY_LIMIT=900
EXA_API_KEY=
# EXA_MONTHLY_LIMIT=500
# Self-hosted SearXNG (unlimited) — see deploy/searxng/README.md, e.g. https://search.example.com/<secret-path>
SEARXNG_URL=
# Jina: optional key raises Reader limits (full job descriptions) and enables Jina embeddings
JINA_API_KEY=
# How many web queries each hourly run may use (when the budget allows)
# WEB_QUERIES_PER_RUN=2

# --- Optional job APIs (free tiers) ------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_DAILY_LIMIT=200
JOOBLE_API_KEY=
# JOOBLE_MONTHLY_LIMIT=450
# JSearch on RapidAPI (aggregates LinkedIn / Indeed / Glassdoor / Naukri postings)
RAPIDAPI_KEY=
# JSEARCH_MONTHLY_LIMIT=180
# Google Jobs via SerpApi
SERPAPI_API_KEY=
# SERPAPI_MONTHLY_LIMIT=230

# --- Semantic job matching (embeddings, 384-d, all free) ----------------------
# Uses GEMINI_API_KEY or JINA_API_KEY automatically. Optional third option: the
# Supabase Edge Function in supabase/functions/embed (gte-small) — deploy it, then:
# EMBED_FUNCTION_ENABLED=true
# EMBEDDINGS_PROVIDER_ORDER=gemini,jina,supabase

# --- Tuning -------------------------------------------------------------------
# Full descriptions fetched (via Jina Reader / Workday) for the top N jobs per run before scoring
# JOBS_ENRICH_PER_RUN=8
# JOBS_MAX_SCORED_PER_RUN=32
# JOBS_MIN_RELEVANCE=0.3
# Jobs per AI scoring call (small enough for Groq's free per-minute limit)
# JOBS_SCORE_BATCH=5

# ---------------------------------------------------------------------------
# Scout worker (optional): worker-only settings (name, JobSpy sites, Gmail app
# passwords) go in worker/.env — see worker/.env.example and worker/README.md.
# The worker also reads this file.
# ---------------------------------------------------------------------------
