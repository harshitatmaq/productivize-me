# =============================================================================
# Productivize — environment variables
# Copy to .env.local for local dev; add the same keys in Vercel → Settings →
# Environment Variables for production. Only NEXT_PUBLIC_* values reach the
# browser; everything else stays on the server.
# =============================================================================

# --- App -----------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Only these emails can sign in (comma separated). You + your friend.
ALLOWED_EMAILS=you@example.com,friend@example.com
# Any long random string. The scheduler (Supabase pg_cron) sends it as a Bearer token.
# Generate one: openssl rand -hex 32
CRON_SECRET=

# --- Supabase (Project Settings → API) -------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# "Publishable" key (older projects call it the anon key — either works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret" key (older projects: service_role). Server only — used by background jobs.
SUPABASE_SECRET_KEY=

# --- Web push (generate once: npm run vapid) ---------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Email digests (any SMTP; Gmail needs an App Password) -------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=
EMAIL_FROM="Productivize <you@gmail.com>"

# --- LLMs: free tiers, tried in this order (best → slowest-but-reliable) -------
# Anything without a key is skipped. Each *_MODELS takes a comma-separated list;
# rate limits are per model, so the chain tries every model before moving on.
LLM_PROVIDER_ORDER=groq,cerebras,gemini,openrouter,mistral,maq

GROQ_API_KEY=
# GROQ_MODELS=llama-3.3-70b-versatile,openai/gpt-oss-120b,meta-llama/llama-4-scout-17b-16e-instruct

CEREBRAS_API_KEY=
# CEREBRAS_MODELS=gpt-oss-120b,qwen-3-235b-a22b-instruct-2507,llama3.1-8b

GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

OPENROUTER_API_KEY=
# OPENROUTER_MODELS=openai/gpt-oss-120b:free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3.1:free

MISTRAL_API_KEY=
# MISTRAL_MODELS=mistral-small-latest

# MAQ AI — OpenAI-compatible endpoint, kept last because it's slow but always available.
MAQ_AI_BASE_URL=https://your-maq-endpoint.example.com/v1
MAQ_AI_API_KEY=
MAQ_AI_MODELS=
# MAQ_AI_TIMEOUT_MS=180000
# MAQ_AI_JSON_MODE=false

# --- Web search for jobs (fallback order; budgets are spread evenly over the month)
SEARCH_PROVIDER_ORDER=tavily,serper,brave,exa,searxng
TAVILY_API_KEY=
# TAVILY_MONTHLY_LIMIT=900
SERPER_API_KEY=
# SERPER_MONTHLY_LIMIT=200
BRAVE_API_KEY=
# BRAVE_MONTHLY_LIMIT=900
EXA_API_KEY=
# EXA_MONTHLY_LIMIT=500
# Self-hosted SearXNG (unlimited) — see deploy/searxng/README.md, e.g. https://search.example.com/<secret-path>
SEARXNG_URL=
# Jina: optional key raises Reader limits (full job descriptions) and enables Jina embeddings
JINA_API_KEY=
# How many web queries each hourly run may use (when the budget allows)
# WEB_QUERIES_PER_RUN=2

# --- Optional job APIs (free tiers) ------------------------------------------
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_DAILY_LIMIT=200
JOOBLE_API_KEY=
# JOOBLE_MONTHLY_LIMIT=450
# JSearch on RapidAPI (aggregates LinkedIn / Indeed / Glassdoor / Naukri postings)
RAPIDAPI_KEY=
# JSEARCH_MONTHLY_LIMIT=180
# Google Jobs via SerpApi
SERPAPI_API_KEY=
# SERPAPI_MONTHLY_LIMIT=230

# --- Semantic job matching (embeddings, 384-d, all free) ----------------------
# Uses GEMINI_API_KEY or JINA_API_KEY automatically. Optional third option: the
# Supabase Edge Function in supabase/functions/embed (gte-small) — deploy it, then:
# EMBED_FUNCTION_ENABLED=true
# EMBEDDINGS_PROVIDER_ORDER=gemini,jina,supabase

# --- Tuning -------------------------------------------------------------------
# Full descriptions fetched (via Jina Reader / Workday) for the top N jobs per run before scoring
# JOBS_ENRICH_PER_RUN=8
# JOBS_MAX_SCORED_PER_RUN=32
# JOBS_MIN_RELEVANCE=0.3
